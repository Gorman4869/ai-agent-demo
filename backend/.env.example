# Environment template only. The application reads process environment values
# and does not automatically load this file or a local .env file.
AI_AGENT_RUNTIME=manual
AI_AGENT_MODEL_PROVIDER=mock
AI_AGENT_ONLINE_ENABLED=false
AI_AGENT_TRACE_INCLUDE_SENSITIVE=false

# MCP is disabled by default. Available local IDs are python-knowledge and
# typescript-knowledge; requests cannot supply commands, args, or directories.
AI_AGENT_MCP_SERVERS=
AI_AGENT_MCP_STARTUP_TIMEOUT_MS=5000
AI_AGENT_MCP_REQUEST_TIMEOUT_MS=5000

# PostgreSQL is explicit opt-in. A DSN alone does not replace memory adapters.
AI_AGENT_PERSISTENCE=memory
AI_AGENT_POSTGRES_DSN=

# A key and model never enable network access by themselves. OpenAI requires
# an online-capable runtime, provider=openai, and online=true at the same time.
OPENAI_API_KEY=
OPENAI_MODEL=

# DashScope Embedding is a separate, explicit provider. The base URL must be
# the trusted Model Studio workspace endpoint ending in /compatible-mode/v1.
DASHSCOPE_API_KEY=
AI_AGENT_DASHSCOPE_BASE_URL=

# Embedding stays deterministic and offline unless its own provider, model,
# revision, a provider-specific key, and the global online switch all opt in.
AI_AGENT_EMBEDDING_PROVIDER=offline
AI_AGENT_EMBEDDING_MODEL=
AI_AGENT_EMBEDDING_REVISION=
AI_AGENT_EMBEDDING_DIMENSIONS=3
AI_AGENT_EMBEDDING_BATCH_SIZE=32
AI_AGENT_EMBEDDING_CACHE_MAX_ENTRIES=256
AI_AGENT_EMBEDDING_REQUEST_TIMEOUT_MS=20000
AI_AGENT_EMBEDDING_MAX_RETRIES=2

# Server-owned hard limits. M8-T1 validates them; later runtime tasks consume them.
AI_AGENT_MAX_STEPS=8
AI_AGENT_MAX_MODEL_CALLS=8
AI_AGENT_RUN_TIMEOUT_MS=30000
AI_AGENT_MODEL_TIMEOUT_MS=20000
AI_AGENT_MAX_INPUT_TOKENS=16000
AI_AGENT_MAX_OUTPUT_TOKENS=2000
AI_AGENT_MAX_COST_USD=0.25
AI_AGENT_MAX_MODEL_RETRIES=2
