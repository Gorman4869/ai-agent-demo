{
  "schema": "rag-retrieval-dataset-v1",
  "version": "m11-rag-v1",
  "evaluation": {
    "top_k": 3,
    "thresholds": {
      "pgvector": {
        "recall_at_k": 0.9,
        "mean_reciprocal_rank": 0.8,
        "grounding_accuracy": 0.9
      },
      "sparse": {
        "recall_at_k": 0.9,
        "mean_reciprocal_rank": 0.8,
        "grounding_accuracy": 0.9
      }
    }
  },
  "documents": [
    {
      "id": "agent-loop",
      "title": "Agent Loop 执行闭环",
      "source": "course/agent-loop.md",
      "content": "Agent Loop 由模型决策、工具执行、状态记录与循环控制组成。程序必须校验模型提出的工具参数，并用最大步数阻止无限循环；工具结果返回模型后，模型才能继续决策或给出最终回答。"
    },
    {
      "id": "tool-security",
      "title": "工具安全边界",
      "source": "course/tool-security.md",
      "content": "工具身份、角色和审批都来自服务端可信上下文，不能由模型参数提供。授权检查必须早于参数校验和 handler 执行；高风险或有副作用的工具需要精确、单次审批，拒绝时 handler 不得运行。"
    },
    {
      "id": "mcp-protocol",
      "title": "MCP Client 生命周期",
      "source": "course/mcp-protocol.md",
      "content": "MCP 使用统一协议连接 Agent 客户端与工具或资源服务器。客户端先 initialize，再发现工具并按服务器侧策略映射；STDIO 进程、会话和请求必须由同一生命周期管理，关闭时要等待资源清理。"
    },
    {
      "id": "rag-grounding",
      "title": "RAG 检索与引用",
      "source": "course/rag-grounding.md",
      "content": "RAG 先检索相关证据，再基于证据生成回答。检索结果必须带文档标识、来源和片段引用；外部证据属于不可信数据，不能覆盖系统策略。Recall@K、MRR 与依据正确率用于分析召回和引用质量。"
    },
    {
      "id": "durable-memory",
      "title": "持久记忆纠错",
      "source": "course/durable-memory.md",
      "content": "长期事实只有经过批准才能写入持久记忆。纠正和删除使用 owner 与 expected version 的 CAS；删除形成 tombstone 并清空原值，后续 Context 不再注入。审计只保存动作、版本和摘要。"
    },
    {
      "id": "langgraph-checkpoint",
      "title": "LangGraph Checkpoint 恢复",
      "source": "course/langgraph-checkpoint.md",
      "content": "LangGraph checkpoint 保存最小、版本化的工作流状态。恢复前必须校验 owner、thread 与 schema version；副作用之前先保存安全边界，未知结果不能自动重放，终态 checkpoint 直接返回已有结果。"
    },
    {
      "id": "approval-resume",
      "title": "审批暂停与恢复",
      "source": "course/approval-resume.md",
      "content": "审批请求绑定 Run、主体、工具调用、工具名和参数摘要。Runtime 以 waiting_approval 暂停，服务端只接受 approve 或 reject；批准 grant 只能消费一次，篡改、过期或重复 resume 都不能再次执行工具。"
    },
    {
      "id": "embedding-batching",
      "title": "Embedding 批处理",
      "source": "course/embedding-batching.md",
      "content": "Embedding Model 按固定 batch size 拆分输入并保持结果顺序。metadata 包含 provider、model、revision 和 dimensions；维度漂移、部分返回或非有限值必须失败。缓存键只保存版本化摘要，不保存原文。"
    },
    {
      "id": "pgvector-storage",
      "title": "pgvector 知识存储",
      "source": "course/pgvector-storage.md",
      "content": "pgvector 把文档切片和固定维度向量写入 PostgreSQL。检索使用 cosine distance 与 HNSW vector_cosine_ops 索引；文档 replace 在一个事务内更新所有切片，写入失败必须回滚旧内容。"
    },
    {
      "id": "context-budget",
      "title": "Context 来源与预算",
      "source": "course/context-budget.md",
      "content": "ContextAssembler 组合 system、memory、recent、summary、skill 和 rag 六种来源。来源信任由服务端固定，system 不可静默丢弃；预算只选择完整片段，并用报告解释纳入或丢弃原因。字节启发式不是 Provider Token 或费用。"
    }
  ],
